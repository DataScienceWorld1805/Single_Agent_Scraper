# Proveedor LLM:
# groq | gemini | openai | anthropic | mistral | deepseek | openrouter | ollama
LLM_PROVIDER=groq

# Groq (https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic / Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Mistral (https://console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (https://openrouter.ai) — agregador multi-modelo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Ollama local (https://ollama.com) — no requiere key real
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Fetch / resiliencia
HTTP_TIMEOUT=30
PLAYWRIGHT_TIMEOUT=45000
MAX_FETCH_RETRIES=3
MAX_EXTRACTION_RETRIES=3
MAX_MARKDOWN_CHARS=12000

# Tope de productos por scrape (1–500). Afecta APIs Coto/Carrefour, XHR y listados.
MAX_PRODUCTS=40

# Proxies opcionales (separados por coma). Ejemplo: http://user:pass@host:port
PROXY_LIST=

# Imágenes y salida
DOWNLOAD_IMAGES=false
OUTPUT_DIR=./output
IMAGE_DOWNLOAD_CONCURRENCY=5

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
